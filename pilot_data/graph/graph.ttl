<https://example.org/kg-navigation-rlvr/ontology> a owl:Ontology ;
    rdfs:label "Knowledge graph navigation RLVR" ;
    rdfs:comment "Fictional research ecosystem. Closed-world generation constraints are checked by the Python validator; no inference is applied during navigation." .

kg:cardinality a owl:AnnotationProperty .

kg:collaborates_with a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "collaborates_with" ;
    rdfs:domain kg:researcher ;
    rdfs:range kg:researcher ;
    kg:cardinality "many_to_many" ;
    kg:constraints "Symmetric, reciprocal stored triples, no self edges." ;
    kg:inverseSupported false ;
    kg:relationId "collaborates_with" .

kg:constraints a owl:AnnotationProperty .

kg:entityId a owl:AnnotationProperty .

kg:inverseSupported a owl:AnnotationProperty .

kg:inverse_authored_by a owl:ObjectProperty ;
    rdfs:label "inv:authored_by" ;
    rdfs:domain kg:researcher ;
    rdfs:range kg:publication ;
    owl:inverseOf kg:authored_by .

kg:inverse_based_in a owl:ObjectProperty ;
    rdfs:label "inv:based_in" ;
    rdfs:domain kg:city ;
    rdfs:range kg:funder ;
    owl:inverseOf kg:based_in .

kg:inverse_cites a owl:ObjectProperty ;
    rdfs:label "inv:cites" ;
    rdfs:domain kg:publication ;
    rdfs:range kg:publication ;
    owl:inverseOf kg:cites .

kg:inverse_city_in_country a owl:ObjectProperty ;
    rdfs:label "inv:city_in_country" ;
    rdfs:domain kg:country ;
    rdfs:range kg:city ;
    owl:inverseOf kg:city_in_country .

kg:inverse_contributes_to a owl:ObjectProperty ;
    rdfs:label "inv:contributes_to" ;
    rdfs:domain kg:project ;
    rdfs:range kg:researcher ;
    owl:inverseOf kg:contributes_to .

kg:inverse_funded_by a owl:ObjectProperty ;
    rdfs:label "inv:funded_by" ;
    rdfs:domain kg:funder ;
    rdfs:range kg:project ;
    owl:inverseOf kg:funded_by .

kg:inverse_investigates a owl:ObjectProperty ;
    rdfs:label "inv:investigates" ;
    rdfs:domain kg:field ;
    rdfs:range kg:project ;
    owl:inverseOf kg:investigates .

kg:inverse_led_by a owl:ObjectProperty ;
    rdfs:label "inv:led_by" ;
    rdfs:domain kg:researcher ;
    rdfs:range kg:project ;
    owl:inverseOf kg:led_by .

kg:inverse_located_in_city a owl:ObjectProperty ;
    rdfs:label "inv:located_in_city" ;
    rdfs:domain kg:city ;
    rdfs:range kg:university ;
    owl:inverseOf kg:located_in_city .

kg:inverse_produced_by a owl:ObjectProperty ;
    rdfs:label "inv:produced_by" ;
    rdfs:domain kg:project ;
    rdfs:range kg:publication ;
    owl:inverseOf kg:produced_by .

kg:inverse_publication_field a owl:ObjectProperty ;
    rdfs:label "inv:publication_field" ;
    rdfs:domain kg:field ;
    rdfs:range kg:publication ;
    owl:inverseOf kg:publication_field .

kg:inverse_specializes_in a owl:ObjectProperty ;
    rdfs:label "inv:specializes_in" ;
    rdfs:domain kg:field ;
    rdfs:range kg:researcher ;
    owl:inverseOf kg:specializes_in .

kg:inverse_subfield_of a owl:ObjectProperty ;
    rdfs:label "inv:subfield_of" ;
    rdfs:domain kg:field ;
    rdfs:range kg:field ;
