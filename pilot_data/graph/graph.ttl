kg:authored_by a owl:ObjectProperty ;
    rdfs:label "authored_by" ;
    rdfs:domain kg:publication ;
    rdfs:range kg:researcher ;
    kg:cardinality "many_to_many" ;
    kg:constraints "At least one author; the primary author leads the producing project." ;
    kg:inverseSupported true ;
    kg:relationId "authored_by" .

kg:based_in a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "based_in" ;
    rdfs:domain kg:funder ;
    rdfs:range kg:city ;
    kg:cardinality "many_to_one" ;
    kg:constraints "Exactly one city per funding organization." ;
    kg:inverseSupported true ;
    kg:relationId "based_in" .

kg:cites a owl:ObjectProperty ;
    rdfs:label "cites" ;
    rdfs:domain kg:publication ;
    rdfs:range kg:publication ;
    kg:cardinality "many_to_many" ;
    kg:constraints "No self citations; citations form a DAG from later to earlier publication IDs." ;
    kg:inverseSupported true ;
    kg:relationId "cites" .

kg:city_in_country a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "city_in_country" ;
    rdfs:domain kg:city ;
    rdfs:range kg:country ;
    kg:cardinality "many_to_one" ;
    kg:constraints "Exactly one country per city." ;
    kg:inverseSupported true ;
    kg:relationId "city_in_country" .

kg:contributes_to a owl:ObjectProperty ;
    rdfs:label "contributes_to" ;
    rdfs:domain kg:researcher ;
    rdfs:range kg:project ;
    kg:cardinality "many_to_many" ;
    kg:constraints "Includes all project leaders; researchers may join multiple projects." ;
    kg:inverseSupported true ;
    kg:relationId "contributes_to" .

kg:funded_by a owl:ObjectProperty ;
    rdfs:label "funded_by" ;
    rdfs:domain kg:project ;
    rdfs:range kg:funder ;
    kg:cardinality "many_to_many" ;
    kg:constraints "At least one funder per project." ;
    kg:inverseSupported true ;
    kg:relationId "funded_by" .

kg:investigates a owl:ObjectProperty ;
    rdfs:label "investigates" ;
    rdfs:domain kg:project ;
    rdfs:range kg:field ;
    kg:cardinality "many_to_many" ;
    kg:constraints "At least one field; includes the primary leader's specialty." ;
    kg:inverseSupported true ;
    kg:relationId "investigates" .

kg:led_by a owl:ObjectProperty ;
    rdfs:label "led_by" ;
    rdfs:domain kg:project ;
    rdfs:range kg:researcher ;
    kg:cardinality "many_to_many" ;
    kg:constraints "At least one leader; every leader contributes to the project." ;
    kg:inverseSupported true ;
    kg:relationId "led_by" .

kg:located_in_city a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "located_in_city" ;
    rdfs:domain kg:university ;
    rdfs:range kg:city ;
    kg:cardinality "many_to_one" ;
    kg:constraints "Exactly one city per university." ;
    kg:inverseSupported true ;
    kg:relationId "located_in_city" .

kg:produced_by a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "produced_by" ;
    rdfs:domain kg:publication ;
    rdfs:range kg:project ;
    kg:cardinality "many_to_one" ;
    kg:constraints "Exactly one producing project per publication." ;
    kg:inverseSupported true ;
    kg:relationId "produced_by" .

kg:publication_field a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "publication_field" ;
    rdfs:domain kg:publication ;
    rdfs:range kg:field ;
    kg:cardinality "many_to_one" ;
    kg:constraints "Exactly one field, investigated by its producing project." ;
    kg:inverseSupported true ;
    kg:relationId "publication_field" .

kg:specializes_in a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "specializes_in" ;
    rdfs:domain kg:researcher ;
    rdfs:range kg:field ;
    kg:cardinality "many_to_one" ;
    kg:constraints "Exactly one primary specialty per researcher." ;
    kg:inverseSupported true ;
    kg:relationId "specializes_in" .

kg:subfield_of a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "subfield_of" ;
    rdfs:domain kg:field ;
    rdfs:range kg:field ;
    kg:cardinality "many_to_one" ;
    kg:constraints "Acyclic forest; zero or one immediate parent per field." ;
    kg:inverseSupported true ;
    kg:relationId "subfield_of" .

kg:works_at a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "works_at" ;
    rdfs:domain kg:researcher ;
    rdfs:range kg:university ;
    kg:cardinality "many_to_one" ;
    kg:constraints "Exactly one employer per researcher." ;
    kg:inverseSupported true ;
    kg:relationId "works_at" .

