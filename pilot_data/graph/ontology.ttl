@prefix kg: <https://example.org/kg-navigation-rlvr/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/kg-navigation-rlvr/ontology> a owl:Ontology ;
    rdfs:label "Knowledge graph navigation RLVR" ;
    rdfs:comment "Fictional research ecosystem. Closed-world generation constraints are checked by the Python validator; no inference is applied during navigation." .

kg:cardinality a owl:AnnotationProperty .

kg:collaborates_with a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "collaborates_with" ;
    rdfs:domain kg:researcher ;
    rdfs:range kg:researcher ;
    kg:cardinality "many_to_many" ;
    kg:constraints "Symmetric, reciprocal stored triples, no self edges." ;
    kg:inverseSupported false ;
    kg:relationId "collaborates_with" .

kg:constraints a owl:AnnotationProperty .

kg:entityId a owl:AnnotationProperty .

kg:inverseSupported a owl:AnnotationProperty .

kg:inverse_authored_by a owl:ObjectProperty ;
    rdfs:label "inv:authored_by" ;
    rdfs:domain kg:researcher ;
    rdfs:range kg:publication ;
    owl:inverseOf kg:authored_by .

kg:inverse_based_in a owl:ObjectProperty ;
    rdfs:label "inv:based_in" ;
    rdfs:domain kg:city ;
    rdfs:range kg:funder ;
    owl:inverseOf kg:based_in .

kg:inverse_cites a owl:ObjectProperty ;
    rdfs:label "inv:cites" ;
    rdfs:domain kg:publication ;
    rdfs:range kg:publication ;
    owl:inverseOf kg:cites .

kg:inverse_city_in_country a owl:ObjectProperty ;
    rdfs:label "inv:city_in_country" ;
    rdfs:domain kg:country ;
    rdfs:range kg:city ;
    owl:inverseOf kg:city_in_country .

kg:inverse_contributes_to a owl:ObjectProperty ;
    rdfs:label "inv:contributes_to" ;
    rdfs:domain kg:project ;
    rdfs:range kg:researcher ;
    owl:inverseOf kg:contributes_to .

kg:inverse_funded_by a owl:ObjectProperty ;
    rdfs:label "inv:funded_by" ;
    rdfs:domain kg:funder ;
    rdfs:range kg:project ;
    owl:inverseOf kg:funded_by .

kg:inverse_investigates a owl:ObjectProperty ;
    rdfs:label "inv:investigates" ;
    rdfs:domain kg:field ;
    rdfs:range kg:project ;
    owl:inverseOf kg:investigates .

kg:inverse_led_by a owl:ObjectProperty ;
    rdfs:label "inv:led_by" ;
    rdfs:domain kg:researcher ;
    rdfs:range kg:project ;
    owl:inverseOf kg:led_by .

kg:inverse_located_in_city a owl:ObjectProperty ;
    rdfs:label "inv:located_in_city" ;
    rdfs:domain kg:city ;
    rdfs:range kg:university ;
    owl:inverseOf kg:located_in_city .

kg:inverse_produced_by a owl:ObjectProperty ;
    rdfs:label "inv:produced_by" ;
    rdfs:domain kg:project ;
    rdfs:range kg:publication ;
    owl:inverseOf kg:produced_by .

kg:inverse_publication_field a owl:ObjectProperty ;
    rdfs:label "inv:publication_field" ;
    rdfs:domain kg:field ;
    rdfs:range kg:publication ;
    owl:inverseOf kg:publication_field .

kg:inverse_specializes_in a owl:ObjectProperty ;
    rdfs:label "inv:specializes_in" ;
    rdfs:domain kg:field ;
    rdfs:range kg:researcher ;
    owl:inverseOf kg:specializes_in .

kg:inverse_subfield_of a owl:ObjectProperty ;
    rdfs:label "inv:subfield_of" ;
    rdfs:domain kg:field ;
    rdfs:range kg:field ;
    owl:inverseOf kg:subfield_of .

kg:inverse_works_at a owl:ObjectProperty ;
    rdfs:label "inv:works_at" ;
    rdfs:domain kg:university ;
    rdfs:range kg:researcher ;
    owl:inverseOf kg:works_at .

kg:partners_with a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "partners_with" ;
    rdfs:domain kg:university ;
    rdfs:range kg:university ;
    kg:cardinality "many_to_many" ;
    kg:constraints "Symmetric, reciprocal stored triples, no self edges." ;
    kg:inverseSupported false ;
    kg:relationId "partners_with" .

kg:relationId a owl:AnnotationProperty .

kg:authored_by a owl:ObjectProperty ;
    rdfs:label "authored_by" ;
    rdfs:domain kg:publication ;
    rdfs:range kg:researcher ;
    kg:cardinality "many_to_many" ;
    kg:constraints "At least one author; the primary author leads the producing project." ;
    kg:inverseSupported true ;
    kg:relationId "authored_by" .

kg:based_in a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "based_in" ;
    rdfs:domain kg:funder ;
    rdfs:range kg:city ;
    kg:cardinality "many_to_one" ;
    kg:constraints "Exactly one city per funding organization." ;
    kg:inverseSupported true ;
    kg:relationId "based_in" .

kg:cites a owl:ObjectProperty ;
    rdfs:label "cites" ;
    rdfs:domain kg:publication ;
    rdfs:range kg:publication ;
    kg:cardinality "many_to_many" ;
    kg:constraints "No self citations; citations form a DAG from later to earlier publication IDs." ;
    kg:inverseSupported true ;
    kg:relationId "cites" .

kg:city_in_country a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "city_in_country" ;
    rdfs:domain kg:city ;
    rdfs:range kg:country ;
    kg:cardinality "many_to_one" ;
    kg:constraints "Exactly one country per city." ;
    kg:inverseSupported true ;
    kg:relationId "city_in_country" .

kg:contributes_to a owl:ObjectProperty ;
    rdfs:label "contributes_to" ;
    rdfs:domain kg:researcher ;
    rdfs:range kg:project ;
    kg:cardinality "many_to_many" ;
    kg:constraints "Includes all project leaders; researchers may join multiple projects." ;
    kg:inverseSupported true ;
    kg:relationId "contributes_to" .

kg:funded_by a owl:ObjectProperty ;
    rdfs:label "funded_by" ;
    rdfs:domain kg:project ;
    rdfs:range kg:funder ;
    kg:cardinality "many_to_many" ;
    kg:constraints "At least one funder per project." ;
    kg:inverseSupported true ;
    kg:relationId "funded_by" .

kg:investigates a owl:ObjectProperty ;
    rdfs:label "investigates" ;
    rdfs:domain kg:project ;
    rdfs:range kg:field ;
    kg:cardinality "many_to_many" ;
    kg:constraints "At least one field; includes the primary leader's specialty." ;
    kg:inverseSupported true ;
    kg:relationId "investigates" .

kg:led_by a owl:ObjectProperty ;
    rdfs:label "led_by" ;
    rdfs:domain kg:project ;
    rdfs:range kg:researcher ;
    kg:cardinality "many_to_many" ;
    kg:constraints "At least one leader; every leader contributes to the project." ;
    kg:inverseSupported true ;
    kg:relationId "led_by" .

kg:located_in_city a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "located_in_city" ;
    rdfs:domain kg:university ;
    rdfs:range kg:city ;
    kg:cardinality "many_to_one" ;
    kg:constraints "Exactly one city per university." ;
    kg:inverseSupported true ;
    kg:relationId "located_in_city" .

kg:produced_by a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "produced_by" ;
    rdfs:domain kg:publication ;
    rdfs:range kg:project ;
    kg:cardinality "many_to_one" ;
    kg:constraints "Exactly one producing project per publication." ;
    kg:inverseSupported true ;
    kg:relationId "produced_by" .

kg:publication_field a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "publication_field" ;
    rdfs:domain kg:publication ;
    rdfs:range kg:field ;
    kg:cardinality "many_to_one" ;
    kg:constraints "Exactly one field, investigated by its producing project." ;
    kg:inverseSupported true ;
    kg:relationId "publication_field" .

kg:specializes_in a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "specializes_in" ;
    rdfs:domain kg:researcher ;
    rdfs:range kg:field ;
    kg:cardinality "many_to_one" ;
    kg:constraints "Exactly one primary specialty per researcher." ;
    kg:inverseSupported true ;
    kg:relationId "specializes_in" .

kg:subfield_of a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "subfield_of" ;
    rdfs:domain kg:field ;
    rdfs:range kg:field ;
    kg:cardinality "many_to_one" ;
    kg:constraints "Acyclic forest; zero or one immediate parent per field." ;
    kg:inverseSupported true ;
    kg:relationId "subfield_of" .

kg:works_at a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "works_at" ;
    rdfs:domain kg:researcher ;
    rdfs:range kg:university ;
    kg:cardinality "many_to_one" ;
    kg:constraints "Exactly one employer per researcher." ;
    kg:inverseSupported true ;
    kg:relationId "works_at" .

kg:country a owl:Class ;
    rdfs:label "country" .

kg:funder a owl:Class ;
    rdfs:label "funder" .

kg:city a owl:Class ;
    rdfs:label "city" .

kg:university a owl:Class ;
    rdfs:label "university" .

kg:field a owl:Class ;
    rdfs:label "field" .

kg:project a owl:Class ;
    rdfs:label "project" .

kg:publication a owl:Class ;
    rdfs:label "publication" .

kg:researcher a owl:Class ;
    rdfs:label "researcher" .

